# TMF ODA Transformer MCP Server - Deployment Configuration
# Copy this file to config.env and customize the values for your deployment

# Project Configuration
PROJECT_NAME=tmf-oda-mcp
ENVIRONMENT=dev
REGION=us-east-2

# Network Configuration (REQUIRED)
# VPC where the resources will be deployed
VPC_ID=vpc-xxxxxxxxx

# Public subnets for the Application Load Balancer (minimum 2, different AZs)
PUBLIC_SUBNETS=subnet-xxxxxxxxx,subnet-yyyyyyyyy

# Private subnets for ECS tasks (minimum 2, different AZs)
PRIVATE_SUBNETS=subnet-aaaaaaa,subnet-bbbbbbb

# Container Configuration
IMAGE_TAG=latest
DESIRED_COUNT=2
TASK_CPU=512
TASK_MEMORY=1024

# SSL/HTTPS Configuration (Optional)
# Set to true to enable HTTPS
ENABLE_HTTPS=false

# SSL certificate ARN from AWS Certificate Manager (required if HTTPS enabled)
# CERTIFICATE_ARN=arn:aws:acm:us-east-2:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Custom domain name (optional, requires HTTPS and certificate)
# DOMAIN_NAME=api.example.com

# Deployment Options
BUILD_IMAGE=true
SKIP_TESTS=false
UPDATE_STACK=false

# Health Check Configuration
HEALTH_CHECK_PATH=/health

# Monitoring Configuration
LOG_RETENTION_DAYS=30

# Example configurations for different environments:

# Development Environment
# PROJECT_NAME=tmf-oda-mcp
# ENVIRONMENT=dev
# DESIRED_COUNT=1
# TASK_CPU=256
# TASK_MEMORY=512
# ENABLE_HTTPS=false

# Staging Environment
# PROJECT_NAME=tmf-oda-mcp
# ENVIRONMENT=staging
# DESIRED_COUNT=2
# TASK_CPU=512
# TASK_MEMORY=1024
# ENABLE_HTTPS=true
# CERTIFICATE_ARN=arn:aws:acm:...

# Production Environment
# PROJECT_NAME=tmf-oda-mcp
# ENVIRONMENT=prod
# DESIRED_COUNT=3
# TASK_CPU=1024
# TASK_MEMORY=2048
# ENABLE_HTTPS=true
# CERTIFICATE_ARN=arn:aws:acm:...
# DOMAIN_NAME=api.example.com 