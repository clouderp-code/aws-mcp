# TMF ODA Transformer AWS Configuration Template
# Copy this file to .env and update with your values

# AWS Region where your DynamoDB table and S3 buckets are located
AWS_REGION=us-east-1

# AWS Role ARN for external machine access (comment out if using instance role)
AWS_ROLE_ARN=arn:aws:iam::YOUR-ACCOUNT-ID:role/YOUR-ROLE-NAME

# AWS Profile name (optional, if using AWS CLI profiles)
# AWS_PROFILE=default

# Alternative region setting (AWS_REGION takes precedence)
# AWS_DEFAULT_REGION=us-east-1

# Example configurations:

# For EC2 instances with instance roles:
# AWS_REGION=us-east-1
# (Leave AWS_ROLE_ARN commented out)

# For external machines with role assumption:
# AWS_REGION=us-east-1
# AWS_ROLE_ARN=arn:aws:iam::764119721991:role/AssumableExternalAccessRole

# For development with AWS CLI profiles:
# AWS_REGION=us-east-1
# AWS_PROFILE=myprofile 